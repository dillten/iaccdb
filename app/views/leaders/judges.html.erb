<h1>Judge Experience <%= @year %></h1>

<p>The first,
by decreasing {N_c - N_d}
(<%= link_to 'see notes', "#{pages_path(:notes)}/#judge-leaders" %>),
up to <%= @max_displayed %> judges in each category who have
<ul>
  <li>judged the most flights</li>
  <li>with the most pilots</li>
  <li>most in accordance with the results</li>
</ul>
</p>

<p>
  <% @years.each do |year| %>
    <%= link_to year, leaders_judges_path(year) %>
  <% end %>
</p>
<ul
  id='judge-leaders-tabs'
  class='tabs judge-leaders-category-list'
  data-tabs
>
  <li class="tabs-title is-active judge-leaders-category">
    <a href="#judge-leaders-total" aria-selected="true">Total</a>
  </li>
  <% @results.each do |cat_jy| %>
    <li class="tabs-title judge-leaders-category">
      <a href="#<%= judge_leaders_cat_id(cat_jy[0]) %>">
        <%= cat_jy[0].name %>
      </a>
    </li>
  <% end %>
</ul>
<div
  class='tabs-content judge-leaders-category-collection'
  data-tabs-content="judge-leaders-tabs"
>
  <div id="judge-leaders-total" class="tabs-panel is-active">
    <h4>Total (all categories)</h4>
    <table class='judge_leaders'>
      <tbody>
        <%= render :partial => 'judges/stats_header', :object => 'Judge' %>
        <%= render :partial => 'jy_result', :collection => @total_jy_results %>
      </tbody>
    </table>
  </div>
  <% @results.each do |cat_jy| %>
    <%= render :partial => 'jy_category',
      :locals => {
      category: cat_jy[0],
      jy_results: cat_jy[1],
      is_first: false
    } %>
  <% end %>
</div>

