<tr><td colspan='2'/>
<td class='regional_series_pilot_contest'>
<%= link_to contest_path(regional_series_pilot_contest.contest) do %><span title="<%= regional_series_pilot_contest.contest.name %>"><%= truncate(regional_series_pilot_contest.contest.name, length: 48, omission: '...') %></span><% end %></td>
<td class='total_average'><%= decimal_two(regional_series_pilot_contest.category_value) %></td>
<td class='total_average'><%= regional_series_pilot_contest.total_possible %></td>
<td class='total_percent'><%= score_pct_two(regional_series_pilot_contest.category_value,
  regional_series_pilot_contest.total_possible) %>%</td>
</tr>
