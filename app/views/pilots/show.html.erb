<h1><%= @pilot.name %></h1>

<ul class='no-bullets'>
<% @contests.each do |contest| %>
  <li>
    <%= contest.start %>
    <%= link_to pilot_score_path(@pilot, contest) do %>
      <span title="<%= contest.name %>"><%= truncate(contest.name, length: 48, omission: '...') %></span>
    <% end %>
    (<%= contest.region %>, <%= contest.category %>)
  </li>
<% end %>
</ul>
